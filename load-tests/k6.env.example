# Base
BASE_URL=http://localhost:8080

# Login users (set only the roles you want to run)
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=
PROVIDER_EMAIL=
PROVIDER_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Runtime behavior
INCLUDE_MUTATIONS=false
PAUSE_SECONDS=0.25

# Scenario tuning
PUBLIC_VUS=5
PUBLIC_RAMP_UP=20s
PUBLIC_HOLD=40s
PUBLIC_RAMP_DOWN=20s
CUSTOMER_VUS=2
CUSTOMER_DURATION=1m
PROVIDER_VUS=2
PROVIDER_DURATION=1m
ADMIN_VUS=1
ADMIN_DURATION=1m

# Optional IDs for mutation endpoints
PROVIDER_ID=
SERVICE_ID=
BOOKING_ID=
ADDRESS_ID=
AREA_ID=
CITY_ID=
PENDING_PROVIDER_ID=

# Optional business data
SEARCH_CITY=Mumbai
SEARCH_STATE=Maharashtra
SEARCH_PINCODE=400001
SEARCH_AREA=Andheri East
SERVICE_TYPE=PLUMBING
PAYMENT_METHOD=UPI
BOOKING_DATETIME=2030-01-01T11:00:00
PRICE_ESTIMATE=500
FINAL_PRICE=500
BOOKING_COMPLETION_OTP=
REVIEW_RATING=5

# Optional tokens for one-time endpoints
VERIFY_EMAIL_TOKEN=
PROVIDER_VERIFY_EMAIL_TOKEN=
GOOGLE_ID_TOKEN=
FORGOT_PASSWORD_EMAIL=
RESET_OTP=
RESET_NEW_PASSWORD=

# Optional files (needed for multipart endpoints)
PROFILE_PIC_PATH=
PROVIDER_DOC_PATH=
ENABLE_PROVIDER_REGISTRATION=false

